{
  "name": "kumone-android",
  "version": "0.1.4",
  "description": "Kumone — NetEase Cloud Music client for Android (Capacitor wrapper of the web kernel)",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "crypto-js": "^4.2.0",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "web": "npx http-server www -p 8100 -c-1",
    "try": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/try-app.ps1",
    "test": "node test/verify-crypto.js",
    "test:crypto": "node test/verify-crypto.js",
    "test:smoke": "node test/smoke.js",
    "test:live": "node test/live.js",
    "test:guard": "node test/guard-design.mjs",
    "test:readonly": "node test/snapshot-readonly.mjs",
    "test:model": "node test/model-actions.mjs",
    "test:learnings": "node test/validate-learnings.mjs",
    "test:learnings:browser": "node test/learnings-browser.mjs",
    "test:normalize": "node test/normalize.test.mjs",
    "test:service": "node test/service.test.mjs",
    "test:player": "node test/player.test.mjs",
    "test:login": "node test/login.test.mjs",
    "test:lyrics": "node test/lyrics.test.mjs",
    "test:login:view": "node test/login-view.mjs",
    "test:detail:view": "node test/detail-view.mjs",
    "test:mine:view": "node test/mine-view.mjs",
    "test:back:view": "node test/back-gesture-view.mjs",
    "test:home": "node test/home-view.mjs",
    "test:library": "node test/library-view.mjs",
    "test:nowplaying": "node test/nowplaying-view.mjs",
    "test:model-flow": "node test/model-flow.mjs",
    "test:fm-search": "node test/fm-search.test.mjs",
    "test:fm-search:view": "node test/fm-search-view.mjs",
    "test:try": "node test/try-panel.mjs",
    "test:live:data": "node test/live-data.mjs",
    "test:guard:prove": "python test/prove-guard-selectors.py",
    "test:actions:prove": "python test/prove-actions-align.py",
    "fix:bom": "python test/strip-bom.py",
    "fix:ps1-bom": "python test/ps1-bom.py",
    "check:encoding": "python test/check-encoding.py",
    "bundle:qrcode": "esbuild node_modules/qrcode/lib/browser.js --bundle --format=iife --global-name=QRCode --outfile=www/vendor/qrcode.bundle.js",
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:android": "npm run sync && cd android && gradlew assembleDebug",
    "build:apk": "npm run sync && cd android && gradlew assembleRelease"
  }
}
